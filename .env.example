# Copy to .env for LOCAL use only. .env is gitignored. Never create one in the cloud.
# PAPER credentials only: Alpaca dashboard -> switch to "Paper Trading" -> API Keys.
# Paper key IDs start with "PK"; anything else is refused.

# Leave ALPACA_ENDPOINT unset, or set it to exactly this. Any other value is refused.
# ALPACA_ENDPOINT=https://paper-api.alpaca.markets/v2
ALPACA_API_KEY=PK_your_paper_key_id
ALPACA_SECRET_KEY=your_paper_secret

# Telegram (free): create a bot with @BotFather, message it once, then get your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Research (primary): Tavily FREE tier - 1,000 credits/month, no card. Sign up at tavily.com, copy the
# API key (starts with tvly-). XAHIL caps usage at 900/month and 40/day and never enables paid usage.
TAVILY_API_KEY=

# Optional and paid - leave empty unless you approved it and enabled it in config/integrations.json.
PERPLEXITY_API_KEY=

# Order execution is OFF. Do not set this until you have approved execution.
# XAHIL_ORDER_EXECUTION=enabled
